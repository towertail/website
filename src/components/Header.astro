---
// Shared by the landing pages and the docs. The docs pass search and theme controls in the slot.
import Logo from "./Logo.astro";
import { NAV, SITE_NAME } from "../config/site";

const path = Astro.url.pathname;
---

<div class="tt-header">
  <a class="tt-brand" href="/">
    <Logo />
    {SITE_NAME}
  </a>
  <nav class="tt-nav" aria-label="Main">
    {
      NAV.map((item) => (
        <a
          href={item.href}
          class:list={[{ "tt-hide-sm": item.label === "Changelog" }]}
          aria-current={path.startsWith(item.href) && item.href !== "/" ? "page" : undefined}
        >
          {item.label}
        </a>
      ))
    }
  </nav>
  <div class="tt-extra"><slot /></div>
</div>

<style>
  .tt-header {
    display: flex;
    align-items: center;
    gap: 24px;
    height: 100%;
    min-width: 0;
  }
  .tt-brand {
    display: flex;
    align-items: center;
    gap: 10px;
    font-weight: 700;
    font-size: 17px;
    text-decoration: none;
    color: var(--tt-fg);
    flex-shrink: 0;
  }
  .tt-nav {
    display: flex;
    gap: 20px;
    margin-left: auto;
    font-size: 14px;
  }
  .tt-nav a {
    color: var(--tt-muted);
    text-decoration: none;
  }
  .tt-nav a:hover,
  .tt-nav a[aria-current="page"] {
    color: var(--tt-fg);
  }
  .tt-extra {
    display: flex;
    align-items: center;
    gap: 16px;
  }
  .tt-extra:empty {
    display: none;
  }
  @media (max-width: 820px) {
    .tt-hide-sm {
      display: none;
    }
  }
</style>
