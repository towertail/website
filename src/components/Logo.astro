---
interface Props {
  size?: number;
}
const { size = 20 } = Astro.props;
---

<svg width={size} height={size} viewBox="0 0 20 20" fill="none" aria-hidden="true">
  <rect x="2.5" y="3" width="15" height="6" rx="2" stroke="currentColor" stroke-width="1.6"></rect>
  <rect x="2.5" y="11" width="15" height="6" rx="2" stroke="currentColor" stroke-width="1.6"></rect>
  <circle cx="6" cy="6" r="1" fill="currentColor"></circle>
  <circle cx="6" cy="14" r="1" fill="currentColor"></circle>
</svg>
