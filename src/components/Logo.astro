  <rect x="2.5" y="2" width="15" height="5" rx="1.8" stroke="currentColor" stroke-width="1.6"></rect>
  <rect x="2.5" y="9" width="15" height="5" rx="1.8" stroke="currentColor" stroke-width="1.6"></rect>
  <circle cx="5.6" cy="4.5" r="1" fill="currentColor"></circle>
  <circle cx="5.6" cy="11.5" r="1" fill="currentColor"></circle>
  <path d="M2 16.9 H7 L8.4 15.2 L10.1 18.8 L11.6 16.1 L12.5 16.9 H18" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"></path>
