---
import HostCard, { type Host } from "./HostCard.astro";

// Example hosts. They are not real data.
const hosts: Host[] = [
  {
    name: "web-edge-1",
    platform: "linux/arm64",
    age: "32s",
    status: "ok",
    metrics: [
      { key: "CPU", value: "42%", tint: "ok", kind: "area", values: [28, 39, 33, 50, 44, 56, 44, 61] },
      { key: "MEM", value: "54%", tint: "ok", kind: "area", values: [44, 50, 44, 50, 44, 50] },
      { key: "DISK", value: "37%", tint: "ok", kind: "bars", values: [33, 39, 39, 44, 50, 56, 61] },
      { key: "NET", value: "↓3.2 ↑0.8", values: [33, 50, 39, 67, 44, 72, 50, 67, 56] },
    ],
  },
  {
    name: "db-primary",
    platform: "linux/x86_64",
    age: "18s",
    status: "warn",
    metrics: [
      { key: "CPU", value: "42%", tint: "ok", values: [33, 44, 39, 50, 44, 50, 44] },
      { key: "MEM", value: "81%", tint: "warn", kind: "area", values: [17, 22, 33, 44, 61, 78] },
      { key: "DISK", value: "37%", tint: "ok", kind: "bars", values: [33, 33, 39, 39, 44, 44, 50] },
      { key: "NET", value: "↓3.2 ↑0.8", values: [39, 56, 33, 61, 44, 67, 50] },
    ],
  },
  {
    name: "queue-worker-2",
    platform: "linux/arm64",
    age: "29s",
    status: "crit",
    metrics: [
      { key: "CPU", value: "78%", tint: "ok", values: [50, 61, 50, 67, 56, 72, 61] },
      { key: "MEM", value: "54%", tint: "ok", values: [44, 50, 44, 50, 44] },
      { key: "DISK", value: "96%", tint: "crit", kind: "bars", values: [78, 83, 83, 89, 89, 94, 100] },
      { key: "NET", value: "↓28 ↑10", values: [33, 67, 33, 72, 39, 78, 44, 67] },
    ],
  },
  { name: "backup-node", platform: "", age: "4m ago", status: "off", error: "ssh: connection refused" },
];
const online = hosts.filter((h) => h.status !== "off").length;
const warn = hosts.filter((h) => h.status === "warn").length;
const down = hosts.filter((h) => h.status === "crit" || h.status === "off").length;
---

<figure class="pop" aria-label="The Towertail menu-bar popover with example hosts">
  <div class="pop-head">
    <b>Towertail</b>
    <span>{online} online · {warn} warn · {down} need attention</span>
  </div>
  {hosts.map((h) => <HostCard host={h} />)}
</figure>

<style>
  .pop {
    margin: 0;
    background: var(--tt-panel);
    border: 1px solid var(--tt-line);
    border-radius: 14px;
    padding: 12px;
    display: flex;
    flex-direction: column;
    gap: 10px;
    box-shadow: 0 30px 60px -30px rgb(0 0 0 / 0.6);
    max-width: 380px;
    width: 100%;
    justify-self: end;
  }
  .pop-head {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 4px 6px 10px;
    border-bottom: 1px solid var(--tt-line);
    flex-wrap: wrap;
  }
  .pop-head b {
    font-size: 15px;
  }
  .pop-head span {
    font: 12px var(--tt-font-mono);
    color: var(--tt-muted);
  }
  @media (max-width: 820px) {
    .pop {
      justify-self: start;
    }
  }
</style>
