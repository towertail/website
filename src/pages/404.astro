---
import Base from "../layouts/Base.astro";
---

<Base title="Page not found">
  <div class="wrap nf">
    <span class="label">404</span>
    <h1 class="page-title">This page does not exist.</h1>
    <p class="sub">The link can be old, or the address can have a typing error.</p>
    <a class="btn ghost" href="/">Go to the home page</a>
  </div>
</Base>

<style>
  .nf {
    padding-block: 96px;
  }
</style>
