{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "towertail-web",
  "main": "src/worker/index.ts",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    // The Worker must see each request to redirect www to the apex.
    "run_worker_first": true
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "towertail-web",
      // Set the real id in the deploy ticket (TOWERTAIL-40).
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ],
  "ratelimits": [
    {
      "name": "WAITLIST_LIMIT",
      "namespace_id": "1001",
      "simple": { "limit": 5, "period": 60 }
    }
  ],
  "routes": [
    { "pattern": "towertail.com", "custom_domain": true },
    { "pattern": "www.towertail.com", "custom_domain": true }
  ],
  "observability": { "enabled": true }
}
